# Copy to .env (read by Task). Everything is optional. The environment talks to no GBIF
# environment: users are authenticated by a local stub of the GBIF API, emails go to Mailpit.

# The dwc-dp-analyser-service checkout (relative to local-test/): image and chart.
# ANALYSER_DIR=../../dwc-dp-analyser-service

# Where the images' base eclipse-temurin:17-jre comes from (task build, build:ws).
# BASE_REGISTRY=docker.gbif.org/third-party

# kubectl/helm context of the local cluster (default minikube, the minikube profile name).
# KUBE_CONTEXT=minikube
